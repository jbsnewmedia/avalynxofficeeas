# Basis for plugin code quality (same policy as the avalynxoffice core)
parameters:
    paths:
        - src
        - tests
    bootstrapFiles:
        - vendor-bin/phpunit/vendor/autoload.php
        - vendor/autoload.php
    level: max
    treatPhpDocTypesAsCertain: false
    doctrine:
        allowNullablePropertyForRequiredField: true
