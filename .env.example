# PostgreSQL connection - same database as the avalynxoffice core.
DATABASE_URL="postgresql://my_user:my_password@db:5432/my_database?serverVersion=16&charset=utf8"

# Shared attachment storage volume (same directory as the core mounts).
ATTACHMENT_STORAGE_DIR=data/attachments

# Z-Push state and log directories (plugin-local volumes).
EAS_STATE_DIR=var/eas-state
EAS_LOG_DIR=var/log/eas
EAS_LOGLEVEL=1
